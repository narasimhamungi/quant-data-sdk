# marketdata-lakehouse gold layer (its docker-compose maps host port 5432)
QDS_MARKETDATA_HOST=localhost
QDS_MARKETDATA_PORT=5432
QDS_MARKETDATA_DB=marketdata_lakehouse
QDS_MARKETDATA_USER=mdl
QDS_MARKETDATA_PASSWORD=

# pit-fundamentals-store (its docker-compose maps host port 5433)
QDS_FUNDAMENTALS_HOST=localhost
QDS_FUNDAMENTALS_PORT=5433
QDS_FUNDAMENTALS_DB=pit_fundamentals
QDS_FUNDAMENTALS_USER=pit_user
QDS_FUNDAMENTALS_PASSWORD=

# SEC asks for a descriptive User-Agent with contact details
QDS_SEC_USER_AGENT=quant-data-sdk YourName your.email@example.com
